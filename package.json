{
  "name": "lista-de-afazeres-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://mrjoaocosta21.github.io/Kanban",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/src/index.js",
    "start:api": "node server/src/index.js",
    "db:migrate": "node server/src/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "lint": "eslint .",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  }
}
